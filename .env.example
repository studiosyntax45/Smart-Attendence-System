# Smart Attendance â€” single source of truth for environment variables
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# Copy this file to `.env` at the project root and fill in real values.
# The frontend (Vite) picks up anything starting with VITE_.
# The backend (Express in ./server) picks up everything else via
# server/src/config/env.ts, which loads this file from the project root.
#
# NEVER commit the real `.env` â€” it is already in `.gitignore`.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ MySQL / Prisma (used by backend + Prisma CLI) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL="mysql://root:@localhost:3306/smart_attendance"

# â”€â”€ JWT secrets (backend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-48-byte-random-hex
JWT_REFRESH_SECRET=replace-me-with-48-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# â”€â”€ Google OAuth (backend â€” student sign-in) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match: {BACKEND_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# â”€â”€ College policy (backend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
COLLEGE_DOMAIN=pesu.pes.edu

# â”€â”€ CORS â€” the Vite dev server origin (backend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WEB_ORIGIN=http://localhost:3000

# â”€â”€ External services (backend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
FACE_SERVICE_TIMEOUT_MS=15000`r`n
# â”€â”€ Server (backend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=4000

# â”€â”€ Frontend (Vite) â€” anything below is exposed to the browser â”€â”€â”€â”€â”€
VITE_API_BASE_URL=http://localhost:4000

# Student Google sign-in (college domain check)
VITE_COLLEGE_DOMAIN=pesu.pes.edu

# Face verification service toggle
VITE_FACE_VERIFICATION=true
