# ======================================================================
# Smart Attendance - single source of truth for environment variables
# ======================================================================
# Copy this file to `.env` at the project root and fill in real values.
# The frontend (Vite) picks up anything starting with VITE_.
# The backend (Express in ./server) picks up everything else via
# server/src/config/env.ts, which loads this file from the project root.
#
# NEVER commit the real `.env` - it is already in `.gitignore`.
# ======================================================================

# -- MySQL / Prisma (used by backend + Prisma CLI) ---------------------
DATABASE_URL="mysql://root:@localhost:3306/smart_attendance"

# -- JWT secrets (backend) ---------------------------------------------
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-48-byte-random-hex
JWT_REFRESH_SECRET=replace-me-with-48-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -- Google OAuth (backend - student sign-in) --------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match: {BACKEND_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# -- College policy (backend) ------------------------------------------
COLLEGE_DOMAIN=pesu.pes.edu

# -- CORS - the Vite dev server origin (backend) -----------------------
WEB_ORIGIN=http://localhost:3000

# -- External services (backend) ---------------------------------------
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
FACE_SERVICE_TIMEOUT_MS=15000

# -- Server (backend) ---------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=8000
PORT=4000

# -- Frontend (Vite) - anything below is exposed to the browser --------
VITE_API_BASE_URL=http://localhost:4000

# Student Google sign-in (college domain check)
VITE_COLLEGE_DOMAIN=pesu.pes.edu

# Face verification service toggle
VITE_FACE_VERIFICATION=true
