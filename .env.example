# ======================================================================
# Smart Attendance - single source of truth for environment variables
# ======================================================================
# Copy this file to `.env` at the project root and fill in real values.
# The frontend (Vite) picks up anything starting with VITE_.
# The backend (Express in ./server) picks up everything else via
# server/src/config/env.ts, which loads this file from the project root.
#
# NEVER commit the real `.env` - it is already in `.gitignore`.
# ======================================================================

# -- MySQL / Prisma (used by backend + Prisma CLI) ---------------------
# Use the root password you set when installing MySQL 8.
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/smart_attendance"

# -- JWT secrets (backend) ---------------------------------------------
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-48-byte-random-hex
JWT_REFRESH_SECRET=replace-me-with-48-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -- Google OAuth (backend - optional student sign-in) -----------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match: {BACKEND_ORIGIN}/auth/google/callback
# Leave empty to turn Google sign-in off; everyone then signs in with email + password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# -- College policy (backend) ------------------------------------------
COLLEGE_DOMAIN=pesu.pes.edu

# -- CORS - the Vite dev server origin (backend) -----------------------
WEB_ORIGIN=http://localhost:3000

# -- Face verification service (backend) -------------------------------
# Required while VITE_FACE_VERIFICATION=true: face enrolment sends a photo here.
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_TOKEN=
FACE_SERVICE_TIMEOUT_MS=15000

# -- AI performance feedback (backend - optional) ----------------------
# Uses a local Ollama model; without it the student dashboard shows rule-based advice.
# Set up with: ollama pull qwen2.5:7b-instruct
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=8000

# -- Server (backend) --------------------------------------------------
PORT=4000

# -- Frontend (Vite) - anything below is exposed to the browser --------
VITE_API_BASE_URL=http://localhost:4000

# Student Google sign-in (college domain check)
VITE_COLLEGE_DOMAIN=pesu.pes.edu

# true: enrolment also verifies the face on the server (needs FACE_SERVICE_URL).
# false: browser-only face matching, and the face service isn't needed.
VITE_FACE_VERIFICATION=true